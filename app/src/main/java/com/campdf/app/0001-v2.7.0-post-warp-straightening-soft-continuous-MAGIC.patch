+import numpy as np, cv2, math
+
+def warp(img, quad, out_w, out_h):
+    dst=np.array([[0,0],[out_w,0],[out_w,out_h],[0,out_h]],np.float32)
+    M=cv2.getPerspectiveTransform(np.array(quad,np.float32),dst)
+    return cv2.warpPerspective(img,M,(out_w,out_h),flags=cv2.INTER_CUBIC,borderMode=cv2.BORDER_REPLICATE)
+
+# ---------- geometry refinement: straighten text lines (rotation + keystone) ----------
+def band_angle(gray_band, rng=6.0, step=0.1):
+    # projection-profile skew search on an ink mask
+    h,w=gray_band.shape
+    bg=cv2.GaussianBlur(gray_band,(0,0),25)
+    ink=(gray_band.astype(np.float32)/np.maximum(bg,1)<0.78).astype(np.uint8)
+    ink=cv2.resize(ink,None,fx=0.5,fy=0.5,interpolation=cv2.INTER_AREA)
+    if ink.sum()<200: return None,0
+    hh,ww=ink.shape; c=(ww/2,hh/2)
+    best=None; bs=-1
+    for a in np.arange(-rng,rng+1e-6,step):
+        M=cv2.getRotationMatrix2D(c,a,1.0)
+        r=cv2.warpAffine(ink,M,(ww,hh),flags=cv2.INTER_NEAREST)
+        p=r.sum(1).astype(np.float64)
+        s=np.sum(np.diff(p)**2)
+        if s>bs: bs=s; best=a
+    return best,float(ink.sum())
+
+def straighten(img, nb=6):
+    h,w=img.shape[:2]
+    g=cv2.cvtColor(img,cv2.COLOR_BGR2GRAY)
+    ys=[];angs=[];ws=[]
+    # use central 80% width, overlapping bands over the content area
+    bh=h//nb
+    for i in range(nb):
+        y0=i*bh; y1=min(h,y0+bh+bh//2)
+        a,wt=band_angle(g[y0:y1, int(w*0.1):int(w*0.9)])
+        if a is not None and wt>0:
+            ys.append((y0+y1)/2); angs.append(a); ws.append(wt)
+    if len(ys)<2: return img,None
+    ys=np.array(ys);angs=np.array(angs);ws=np.array(ws)
+    # robust linear fit angle(y)=a0+a1*y (cv2 rotation angle: positive = ccw)
+    for _ in range(3):
+        A=np.vstack([np.ones_like(ys),ys]).T*np.sqrt(ws)[:,None]
+        co,_,_,_=np.linalg.lstsq(A,angs*np.sqrt(ws),rcond=None)
+        res=angs-(co[0]+co[1]*ys)
+        k=np.abs(res)<max(0.6,2*np.median(np.abs(res)))
+        if k.sum()<2: break
+        ys,angs,ws=ys[k],angs[k],ws[k]
+    at=co[0]; ab=co[0]+co[1]*h
+    # a text line that appears rotated by +angle (ccw in cv2 sense) has slope tan(-angle) in image coords (y down)
+    # measured angle = rotation needed to level. Build quad whose edges follow the measured line slopes.
+    tt=math.tan(math.radians(at)); tb=math.tan(math.radians(ab))
+    # source quad: top line and bottom line as seen (slopes tt,tb); verticals kept vertical
+    src=np.array([[0,0],[w,w*tt],[w,h+w*tb],[0,h]],np.float32)
+    # shift so mean maps sensibly
+    src[:,1]-= (src[:,1].mean()-h/2)
+    dst=np.array([[0,0],[w,0],[w,h],[0,h]],np.float32)
+    # rotation correction: use affine-ish via homography
+    M=cv2.getPerspectiveTransform(src,dst)
+    out=cv2.warpPerspective(img,M,(w,h),flags=cv2.INTER_CUBIC,borderMode=cv2.BORDER_REPLICATE)
+    return out,(at,ab,list(zip(ys.round(0),angs.round(2))))
+
+# ---------- trim non-paper strips ----------
+def trim(img, maxfrac=0.08):
+    h,w=img.shape[:2]
+    lab=cv2.cvtColor(cv2.GaussianBlur(img,(0,0),1.5),cv2.COLOR_BGR2LAB).astype(int)
+    L,A=lab[...,0],lab[...,1]
+    Lref=np.percentile(L,70)
+    paper=((L>Lref*0.6)&(abs(A-128)<10))
+    t=b=l=r=0
+    mt=int(h*maxfrac); mw=int(w*maxfrac)
+    while t<mt and paper[t,:].mean()<0.85: t+=1
+    while b<mt and paper[h-1-b,:].mean()<0.85: b+=1
+    while l<mw and paper[:,l].mean()<0.85: l+=1
+    while r<mw and paper[:,w-1-r].mean()<0.85: r+=1
+    pad=3
+    t,b,l,r=[x+pad if x>0 else 0 for x in (t,b,l,r)]
+    return img[t:h-b, l:w-r], (t,b,l,r)
+
+# ---------- illumination ----------
+def paper_map(f, scale=4):
+    # f float32 HxWx3 (0..255). Estimate paper colour per pixel: max-ish filter on downsampled, then smooth
+    h,w=f.shape[:2]
+    s=cv2.resize(f,(max(8,w//scale),max(8,h//scale)),interpolation=cv2.INTER_AREA)
+    k=max(5,int(min(s.shape[:2])*0.06))|1
+    s=cv2.dilate(s,cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(k,k)))   # remove ink
+    s=cv2.erode(s,cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(max(3,k//3)|1,max(3,k//3)|1)))
+    s=cv2.GaussianBlur(s,(0,0),max(2,k/2.5))
+    return cv2.resize(s,(w,h),interpolation=cv2.INTER_CUBIC)
+
+def smoothstep(x): 
+    x=np.clip(x,0,1); return x*x*(3-2*x)
+
+# ---------- new MAGIC: soft, continuous, colour-preserving ----------
+def magic(img, sharp=0.7, chroma_boost=1.35):
+    f=img.astype(np.float32)[...,::-1]          # RGB
+    bgm=np.maximum(paper_map(f),40)
+    # white-balance + flatten: each channel divided by its own paper estimate
+    N=np.clip(f/bgm,0,1.2)
+    # light denoise of chroma only (JPEG chroma noise)
+    ycc=cv2.cvtColor(np.clip(N,0,1).astype(np.float32),cv2.COLOR_RGB2YCrCb)
+    ycc[...,1]=cv2.GaussianBlur(ycc[...,1],(0,0),1.0); ycc[...,2]=cv2.GaussianBlur(ycc[...,2],(0,0),1.0)
+    Y=ycc[...,0]
+    # luminance detail: unsharp with halo clamp
+    blur=cv2.GaussianBlur(Y,(0,0),1.6)
+    Ys=Y+sharp*(Y-blur)
+    lo=cv2.erode(Y,np.ones((3,3),np.uint8)); hi=cv2.dilate(Y,np.ones((3,3),np.uint8))
+    Ys=np.clip(Ys,lo-0.02,hi+0.02)
+    # tone curve on luminance: paper->1, ink deepened (soft S curve, no branching)
+    black,white=0.28,0.90
+    t=np.clip((Ys-black)/(white-black),0,1)
+    Yo=t**1.25
+    Yo=np.where(Ys>=white,1.0,Yo)
+    # chroma carried over (Cr,Cb around .5) scaled by boost, strongest where ink is dark
+    ycc2=np.stack([Yo,0.5+(ycc[...,1]-0.5)*chroma_boost,0.5+(ycc[...,2]-0.5)*chroma_boost],-1).astype(np.float32)
+    rgb=cv2.cvtColor(ycc2,cv2.COLOR_YCrCb2RGB)
+    # fade chroma to zero on paper so background is exactly white, continuously
+    ink=smoothstep((0.93-Ys)/0.25)[...,None]
+    grey=np.repeat(Yo[...,None],3,2)
+    rgb=grey+(rgb-grey)*ink
+    rgb=np.where(Yo[...,None]>0.985,1.0,rgb)
+    return (np.clip(rgb,0,1)*255+0.5).astype(np.uint8)[...,::-1]
