+"""Reference for v2.7.0 (Imaging.kt): warp -> straighten -> trim -> soft MAGIC.
+usage: python run.py photo.jpg x0,y0,x1,y1,x2,y2,x3,y3 out.png   (corners TL,TR,BR,BL in pixels)"""
+import sys, math, cv2, pipe
+img = cv2.imread(sys.argv[1])
+q = [float(v) for v in sys.argv[2].split(',')]
+quad = [(q[0], q[1]), (q[2], q[3]), (q[4], q[5]), (q[6], q[7])]
+W = int((math.dist(quad[0], quad[1]) + math.dist(quad[3], quad[2])) / 2)
+H = int((math.dist(quad[0], quad[3]) + math.dist(quad[1], quad[2])) / 2)
+warped = pipe.warp(img, quad, int(W * 1.2), int(H * 1.2))
+straight, info = pipe.straighten(warped)
+print('line angle top/bottom (deg):', info[:2] if info else None)
+trimmed, t = pipe.trim(straight)
+cv2.imwrite(sys.argv[3], pipe.magic(trimmed, sharp=0.7, chroma_boost=2.8))
