--- /dev/null
+++ b/tools/jvmtest/Main.kt
@@ -0,0 +1,20 @@
+import android.graphics.*
+import com.campdf.app.*
+import javax.imageio.ImageIO
+import java.io.File
+
+fun main(args: Array<String>) {
+    val path = args[0]; val outPath = args[1]; val mode = FilterMode.valueOf(args[2])
+    val quadArg = args.getOrNull(3)
+    val src = Imaging.loadOriented(path, 3600)!!
+    val corners: FloatArray = if (quadArg == null || quadArg == "auto") {
+        val c = Imaging.detectCornersOrNull(path); println("auto corners = ${c?.toList()}"); c ?: Imaging.detectCorners(path)
+    } else quadArg.split(",").map { it.toFloat() }.toFloatArray().let { q ->
+        FloatArray(8) { if (it % 2 == 0) q[it] / (src.width - 1) else q[it] / (src.height - 1) } }
+    val t0 = System.currentTimeMillis()
+    val warped = Imaging.warp(src, corners, 3508)
+    println("warped ${warped.width}x${warped.height}  (${System.currentTimeMillis() - t0} ms)")
+    val out = Imaging.applyFilter(warped, mode)
+    println("done ${out.width}x${out.height}  (${System.currentTimeMillis() - t0} ms)")
+    ImageIO.write(out.toImage(), "png", File(outPath))
+}
